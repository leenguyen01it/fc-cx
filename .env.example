# Neon: dùng chuỗi kết nối "Pooled" (có -pooler trong host) cho app
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Neon: chuỗi "Direct" (không -pooler) để chạy migration lúc build
DATABASE_URL_UNPOOLED=postgres://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Mật khẩu đăng nhập trang admin
ADMIN_PASSWORD=doi-mat-khau-nay
# Chuỗi ngẫu nhiên ≥ 16 ký tự để ký cookie đăng nhập (openssl rand -base64 32)
SESSION_SECRET=
# Khoá bí mật cho webhook SePay (nhập giống hệt ở SePay → Webhook → API Key)
WEBHOOK_API_KEY=

# (tuỳ chọn) URL chính thức, dùng trong tin nhắn Zalo. Mặc định lấy theo domain đang truy cập.
# SITE_URL=https://fc-cx.vercel.app
